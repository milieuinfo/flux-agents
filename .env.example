# Jira Data Center (on-premise)
JIRA_URL="https://jira.omgeving.vlaanderen.be/jira"
JIRA_PERSONAL_TOKEN=your_personal_access_token_here
JIRA_SSL_VERIFY=true

# Project key voor flux-web-components (pas aan)
JIRA_PROJECT_KEY=FLUX

# State folder - aparte locatie, idealiter een eigen git repo (zie README).
# Verwacht als sibling naast deze repo. Kan ook een absoluut pad zijn.
STATE_DIR=../flux-agents-state

# flux-web-components repo die de agents beheren. Bij eerste run wordt
# hier een clone gemaakt onder state/clone/flux-web-components/ (gitignored).
# Volledig los van jouw eigen werk-clone, zodat een refine- of develop-run
# nooit jouw branches of staging raakt.
FLUX_REPO_URL=git@github.com:milieuinfo/flux-web-components.git
FLUX_BASE_BRANCH=develop-v2
# Optioneel: override de locatie van de managed clone
# FLUX_REPO_DIR=./state/clone/flux-web-components

# Model selectie - één variabele per agent-rol.
# - claude-fable-5 = krachtigste tier (1M context, $10/$50 per MTok)
# - claude-opus-5 voor analyse-zwaar werk aan lagere kost (1M, $5/$25)
# - claude-sonnet-5 voor snelle runs / kostenbesparing (1M, $3/$15)
# - claude-haiku-4-5 voor simpel werk (200K, $1/$5)
# Opus waar het oordeel zit (refine, plan, review, converge), Sonnet
# voor develop - de grootste tokenverbruiker (~100 beurten, 2 profielen,
# meerdere rondes per ticket). Gaan tickets structureel naar ronde 3 of
# ESCALATED, zet dan eerst develop naar claude-opus-5 (niet naar Fable).
AGENT_REFINE_MODEL=claude-fable-5
AGENT_PLAN_MODEL=claude-opus-5
AGENT_DEVELOP_MODEL=claude-opus-5
AGENT_REVIEW_MODEL=claude-fable-5
# Beknopte .jira.md-samenvatting bij refine (default: Sonnet).
AGENT_REFINE_SUMMARY_MODEL=claude-sonnet-5
# Converge-agent die twee profielruns combineert (default: = review-model).
AGENT_CONVERGE_MODEL=claude-opus-5
# Externe-review-zijtak (default: = review-model).
AGENT_REVIEW_EXTERNAL_MODEL=claude-fable-5

# Reasoning-effort per agent-rol - stuurt hoe diep het model nadenkt (adaptive
# thinking), naast de model-keuze. Geldige waarden: low | medium | high | xhigh
# | max. Leeg of ongeldig → 'high' (de default, gelijk aan de SDK-default).
# xhigh/max worden enkel door bepaalde Opus-modellen ondersteund.
# AGENT_REFINE_EFFORT=high
# AGENT_REFINE_SUMMARY_EFFORT=high
# AGENT_PLAN_EFFORT=high
# AGENT_DEVELOP_EFFORT=high
# AGENT_REVIEW_EFFORT=high
# AGENT_CONVERGE_EFFORT=high
# AGENT_REVIEW_EXTERNAL_EFFORT=high

# Max beurten per agent-run (override indien een ticket telkens tegen
# de limiet loopt met error_max_turns).
# AGENT_REFINE_MAX_TURNS=30
# AGENT_DEVELOP_MAX_TURNS=60
# AGENT_REVIEW_MAX_TURNS=50
# AGENT_REVIEW_EXTERNAL_MAX_TURNS=100
# AGENT_CONVERGE_MAX_TURNS=150

# Harde timeout per Bash-call (ms) in develop/review/review-external.
# Wordt afgedwongen via een PreToolUse-hook: ontbreekt `timeout` in de
# call of is hij hoger, dan clampen we naar deze waarde. SDK-cap = 600s.
# AGENT_BASH_TIMEOUT_MS=600000

# Refine-agent leest image-attachments (jpeg/png/gif/webp) van het ticket
# en geeft ze door als vision content blocks. Limieten beschermen tegen
# token-budget-explosie bij tickets met veel of zware screenshots.
# JIRA_REFINE_IMAGE_MAX_COUNT=5
# JIRA_REFINE_IMAGE_MAX_BYTES=5000000

# Auteur+committer van git-commits gemaakt door develop (per ronde), review
# (squash bij APPROVED) en converge. Niet gezet → terugval op je globale
# git-identiteit (git config --global user.name/user.email). Is ook die er
# niet, dan stopt de push met een duidelijke fout (geen ingebakken persoon).
# FLUX_GIT_AUTHOR_NAME=Voornaam Achternaam
# FLUX_GIT_AUTHOR_EMAIL=voornaam.achternaam@vlaanderen.be

# Optioneel: als je NIET via je Claude Code MAX sessie wil authenticeren
# ANTHROPIC_API_KEY=sk-ant-...

# Publicatie (`npm run jira:publish`): de epic waaraan het [Sprint-analyse]-ticket
# wordt gehangen, als issue-key (bv. FLUX-42) of als Epic Name. Leeg laten =
# geen epic-link. Het sprint-veld, het link-type "Wordt gerealiseerd door" en de
# Epic Link/Name-velden worden door publish.ts zelf gedetecteerd.
JIRA_UMBRELLA_EPIC="[2026] - samenwerking"

# Log level: debug | info | warn | error
# info  = compacte voortgang: stappen (▸/✓), narratie van de agent, één regel
#         per tool-call, heartbeat bij stilte
# debug = ook de volledige SDK-stroom (tool-inputs/-resultaten, shell-output,
#         stacktraces)
LOG_LEVEL=info
