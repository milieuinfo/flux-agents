{
  "name": "flux-agents",
  "productName": "Flux Agents",
  "version": "0.5.1",
  "description": "Lokale agent pipeline voor Flux web components ticket workflow",
  "private": true,
  "type": "module",
  "main": "app/desktop/dist/main.cjs",
  "scripts": {
    "pipeline:refine": "tsx pipeline/agents/refine.ts",
    "pipeline:plan": "tsx pipeline/agents/plan.ts",
    "pipeline:develop": "tsx pipeline/agents/develop.ts",
    "pipeline:review": "tsx pipeline/agents/review.ts",
    "pipeline:review-external": "tsx pipeline/agents/review-external.ts",
    "pipeline:ship": "tsx pipeline/agents/ship.ts",
    "pipeline:iterate": "tsx pipeline/agents/iterate.ts",
    "pipeline:converge": "tsx pipeline/agents/converge.ts",
    "pipeline:refine:dry": "DRY_RUN=1 tsx pipeline/agents/refine.ts",
    "jira:publish": "tsx pipeline/jira/publish.ts",
    "jira:publish-ticket": "tsx pipeline/jira/publish.ts --skip-overview",
    "jira:publish-review": "tsx pipeline/jira/publish-review.ts",
    "jira:publish:dry": "DRY_RUN=1 tsx pipeline/jira/publish.ts",
    "jira:publish-review:dry": "DRY_RUN=1 tsx pipeline/jira/publish-review.ts",
    "git:push": "tsx pipeline/git/push.ts",
    "git:pr": "tsx pipeline/git/pr.ts",
    "state:close-sprint": "tsx pipeline/state/close-sprint.ts",
    "state:close-external": "tsx pipeline/state/close-external.ts",
    "start": "tsx app/tui/index.ts",
    "app:tui": "tsx app/tui/index.ts",
    "app:dev": "node app/desktop/dev-app-name.mjs && node app/desktop/build.mjs && electron app/desktop/dist/main.cjs",
    "app:build": "node app/desktop/build.mjs",
    "app:dist": "node app/desktop/build.mjs && PYTHON_PATH=\"$(command -v python3)\" electron-builder --mac",
    "app:pack": "node app/desktop/build.mjs && electron-builder --dir",
    "app:rebuild": "electron-rebuild -f -w node-pty",
    "dev:typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "dev:log-preview": "tsx tools/log-preview.ts",
    "dev:help-preview": "tsx tools/help-preview.ts",
    "dev:check-dashes": "./tools/check-dashes.sh",
    "postinstall": "patch-package --patch-dir tools/patches && electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.229",
    "@clack/prompts": "^1.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "node-pty": "^1.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
