{
  "name": "flux-agents",
  "version": "0.1.0",
  "description": "Lokale agent pipeline voor Flux web components ticket workflow",
  "private": true,
  "type": "module",
  "main": "desktop/dist/main.cjs",
  "scripts": {
    "start": "tsx tui/index.ts",
    "tui": "tsx tui/index.ts",
    "dev": "node desktop/build.mjs && electron desktop/dist/main.cjs",
    "build": "node desktop/build.mjs",
    "dist": "node desktop/build.mjs && electron-builder --mac",
    "pack": "node desktop/build.mjs && electron-builder --dir",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "patch-package && electron-rebuild -f -w node-pty",
    "typecheck:desktop": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "refine": "tsx agents/refine.ts",
    "plan": "tsx agents/plan.ts",
    "develop": "tsx agents/develop.ts",
    "review": "tsx agents/review.ts",
    "review-external": "tsx agents/review-external.ts",
    "ship": "tsx agents/ship.ts",
    "iterate": "tsx agents/iterate.ts",
    "converge": "tsx agents/converge.ts",
    "push": "tsx scripts/push.ts",
    "pr": "tsx scripts/pr.ts",
    "publish": "tsx scripts/publish.ts",
    "publish:ticket": "tsx scripts/publish.ts --skip-overview",
    "publish-review": "tsx scripts/publish-review.ts",
    "refine:dry": "DRY_RUN=1 tsx agents/refine.ts",
    "publish:dry": "DRY_RUN=1 tsx scripts/publish.ts",
    "publish-review:dry": "DRY_RUN=1 tsx scripts/publish-review.ts",
    "sync-cc-agents": "./scripts/sync-cc-agents.sh",
    "link-commands": "./scripts/link-commands.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.117",
    "@clack/prompts": "^1.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^16.4.5",
    "node-pty": "^1.1.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^22.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
